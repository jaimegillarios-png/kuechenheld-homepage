---
import Section from "../ui/Section";
import { Eyebrow, Heading, Lede } from "../ui/SectionHeader";
import FeaturedArticle from "../ui/FeaturedArticle";
import PostCard from "../ui/PostCard";
import CategoryLinks, { type CategoryLink } from "./CategoryLinks";
import Pagination from "./Pagination";
import BlogSearch from "./BlogSearch";
import type { PostSummary } from "../../lib/blog";
import { asset } from "../../lib/site";
import styles from "./BlogIndex.module.css";

/**
 * The body of every index route: /blog, its numbered pages, and each
 * category and its pages. The four route files differ only in which posts
 * they hand over and how they build a page href.
 *
 * The lead story sits inside the masthead band rather than under it, so the
 * top of the page reads as one composition — a front page — and the grid
 * below is plainly everything else. The category row is that grid's own
 * header, not a masthead control: it answers "what else is there", which is
 * a question you ask after the lead, not before it.
 */
interface Props {
  heading: string;
  lede?: string;
  /** The posts on this page, already sliced. */
  posts: PostSummary[];
  /** Shown inside the masthead on the first page of /blog only. */
  featured?: PostSummary | null;
  categories: CategoryLink[];
  /** Every post in scope, for the count beside the category row. */
  total: number;
  page: number;
  totalPages: number;
  hrefFor: (page: number) => string;
  /** Category slug when this page is scoped to one. */
  scope?: string | null;
  scopeName?: string | null;
}

const {
  heading,
  lede,
  posts,
  featured = null,
  categories,
  total,
  page,
  totalPages,
  hrefFor,
  scope = null,
  scopeName = null,
} = Astro.props;

const dateFormat = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});

const postHref = (slug: string) => asset(`/blog/${slug}`);
const byline = (post: PostSummary) => ({
  author: post.author
    ? { name: post.author.name, avatar: post.author.avatar }
    : null,
  date: post.date ? dateFormat.format(new Date(post.date)) : null,
  dateTime: post.date,
});
---

<Section rhythm="masthead" tone="warm">
  <Eyebrow>Blog</Eyebrow>

  {/* The heading and the search share the band's top row, so the right half
      carries the way in rather than sitting empty above a stranded field. The
      lede takes the row below it — and on a narrow screen the three stack in
      reading order, with the field last. */}
  <div class={styles.headRow}>
    <div class={styles.headHeading}>
      <Heading measure="wide" gap="none">{heading}</Heading>
    </div>
    <div class={styles.search}>
      <BlogSearch
        client:idle
        indexUrl={asset("/blog/search-index.json")}
        postHrefBase={asset("/blog/")}
        scope={scope}
        scopeName={scopeName}
      />
    </div>
    {
      lede && (
        <div class={styles.headLede}>
          <Lede measure="default">{lede}</Lede>
        </div>
      )
    }
  </div>

</Section>

{
  featured && (
    <div class={`${styles.featuredBand} ${styles.hideWhileSearching}`}>
      <div class={styles.featuredInner}>
        <FeaturedArticle
          layout="split"
          href={postHref(featured.slug)}
          title={featured.title}
          excerpt={featured.summary ?? ""}
          meta={[
            "Im Fokus",
            featured.categories[0]?.name,
            featured.date && dateFormat.format(new Date(featured.date)),
          ]
            .filter(Boolean)
            .join(" · ")}
          src={featured.mainImage.src}
          alt={featured.mainImage.alt}
        />
      </div>
    </div>
  )
}

<Section rhythm={featured ? "trail" : "section"}>
  {/* The grid's own header: where else to look, and how much there is. */}
  <div class={styles.bar}>
    <CategoryLinks items={categories} />
    <p class={styles.count}>
      {total} {total === 1 ? "Beitrag" : "Beiträge"}
    </p>
  </div>

  {/* Search results land here, above the grid they stand in for. */}
  <div id="blog-results"></div>

  <div class={styles.hideWhileSearching}>
    <div class={styles.grid}>
      {
        posts.map((post) => (
          <PostCard
            href={postHref(post.slug)}
            title={post.title}
            excerpt={post.summary ?? ""}
            src={post.thumbnailImage.src}
            alt={post.thumbnailImage.alt}
            {...byline(post)}
          />
        ))
      }
    </div>

    <div class={styles.pagination}>
      <Pagination current={page} total={totalPages} hrefFor={hrefFor} />
    </div>
  </div>
</Section>
